rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email == 'redmond262@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('dni' in data) || data.dni == null || (data.dni is string && data.dni.size() <= 20)) &&
             (!('isDniVerified' in data) || data.isDniVerified is bool) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
             (!('defaultVehicle' in data) || data.defaultVehicle == null || (data.defaultVehicle is string && data.defaultVehicle.size() <= 100)) &&
             (!('defaultPlate' in data) || data.defaultPlate == null || (data.defaultPlate is string && data.defaultPlate.size() <= 20)) &&
             (!('trustRole' in data) || data.trustRole in ['docente', 'estudiante', 'salud', 'policia', 'trabajador', 'general', 'admin']) &&
             (!('isProUser' in data) || data.isProUser is bool) &&
             (!('proExpiresAtMillis' in data) || data.proExpiresAtMillis is int || data.proExpiresAtMillis is number) &&
              (!('pointsRuta' in data) || (data.pointsRuta is int && data.pointsRuta >= 0)) &&
              (!('xpTotal' in data) || (data.xpTotal is int && data.xpTotal >= 0)) &&
              (!('dailyPointsEarned' in data) || (data.dailyPointsEarned is int && data.dailyPointsEarned >= 0)) &&
              (!('lastPointsDateString' in data) || data.lastPointsDateString == null || (data.lastPointsDateString is string && data.lastPointsDateString.size() <= 20)) &&
              (!('referralCode' in data) || data.referralCode == null || (data.referralCode is string && data.referralCode.size() <= 24)) &&
              (!('referredByUid' in data) || data.referredByUid == null || (data.referredByUid is string && data.referredByUid.size() <= 128)) &&
              (!('referredByCode' in data) || data.referredByCode == null || (data.referredByCode is string && data.referredByCode.size() <= 24)) &&
              (!('referralCount' in data) || (data.referralCount is int && data.referralCount >= 0)) &&
              (!('alertsCreatedCount' in data) || (data.alertsCreatedCount is int && data.alertsCreatedCount >= 0)) &&
              (!('alertsResolvedCount' in data) || (data.alertsResolvedCount is int && data.alertsResolvedCount >= 0)) &&
              (!('confirmedImpactCount' in data) || (data.confirmedImpactCount is int && data.confirmedImpactCount >= 0)) &&
              (!('lastWeekendProClaimMonth' in data) || data.lastWeekendProClaimMonth == null || (data.lastWeekendProClaimMonth is string && data.lastWeekendProClaimMonth.size() <= 20)) &&
              (!('lastLegendProClaimMonth' in data) || data.lastLegendProClaimMonth == null || (data.lastLegendProClaimMonth is string && data.lastLegendProClaimMonth.size() <= 20)) &&
              (!('isBetaTester' in data) || data.isBetaTester is bool);
    }

    function isValidReferralCode(data) {
      return data.code is string && data.code.size() >= 6 && data.code.size() <= 20 &&
             data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
             (!('ownerName' in data) || data.ownerName == null || (data.ownerName is string && data.ownerName.size() <= 100));
    }

    function isValidReferralRecord(data) {
      return data.refereeUid is string && data.refereeUid.size() > 0 && data.refereeUid.size() <= 128 &&
             data.referrerUid is string && data.referrerUid.size() > 0 && data.referrerUid.size() <= 128 &&
             data.referrerUid != data.refereeUid &&
             data.code is string && data.code.size() >= 6 && data.code.size() <= 20 &&
             data.status in ['pending', 'claimed'] &&
             (!('refereeName' in data) || data.refereeName == null || (data.refereeName is string && data.refereeName.size() <= 100)) &&
             (!('rewardGrantedToReferee' in data) || data.rewardGrantedToReferee is bool) &&
             (!('rewardGrantedToReferrer' in data) || data.rewardGrantedToReferrer is bool);
    }

    function isValidBillingConfig(data) {
      return data.mercadoPagoAlias is string && data.mercadoPagoAlias.size() >= 3 && data.mercadoPagoAlias.size() <= 120 &&
             data.proPriceArs is int && data.proPriceArs >= 0 && data.proPriceArs <= 1000000 &&
             (!('paymentLinkUrl' in data) || data.paymentLinkUrl == null || (data.paymentLinkUrl is string && data.paymentLinkUrl.size() <= 300));
    }

    function isValidFeatureMode(val) {
      return val in ['hidden', 'beta', 'public'];
    }

    function isValidFeatureFlags(data) {
      return isValidFeatureMode(data.aventonMode) &&
             isValidFeatureMode(data.baulVialMode) &&
             (!('reclamosMode' in data) || isValidFeatureMode(data.reclamosMode)) &&
             (!('proConversionMode' in data) || isValidFeatureMode(data.proConversionMode)) &&
             (!('referralsMode' in data) || isValidFeatureMode(data.referralsMode)) &&
             (!('preTripChecklistMode' in data) || isValidFeatureMode(data.preTripChecklistMode));
    }

    function isValidRoadAlert(data) {
      return data.type is string && data.type.size() > 0 && data.type.size() <= 100 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.reporterUid is string && data.reporterUid.size() <= 128 &&
             data.status in ['active', 'resolved'] &&
             (!('heading' in data) || data.heading is number) &&
             (!('directionDesc' in data) || data.directionDesc == null || (data.directionDesc is string && data.directionDesc.size() <= 100)) &&
             (!('depthCm' in data) || data.depthCm is int && data.depthCm >= 0 && data.depthCm <= 100) &&
             (!('roadName' in data) || data.roadName == null || (data.roadName is string && data.roadName.size() <= 120)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             (!('reporterName' in data) || data.reporterName == null || (data.reporterName is string && data.reporterName.size() <= 100)) &&
             (!('affectsBothDirections' in data) || data.affectsBothDirections is bool) &&
             (!('estimatedKm' in data) || data.estimatedKm is int) &&
             (!('confirmations' in data) || data.confirmations is int && data.confirmations >= 0) &&
             (!('notThereVotes' in data) || data.notThereVotes is int && data.notThereVotes >= 0) &&
             (!('roadCategory' in data) || data.roadCategory == null || (data.roadCategory is string && data.roadCategory.size() <= 50)) &&
             (!('connectsTowns' in data) || data.connectsTowns == null || (data.connectsTowns is string && data.connectsTowns.size() <= 150)) &&
             (!('expiresAtMillis' in data) || data.expiresAtMillis is int || data.expiresAtMillis is number) &&
             (!('authorBonusAwarded' in data) || data.authorBonusAwarded is bool) &&
             (!('reporterLevel' in data) || (data.reporterLevel is int && data.reporterLevel >= 1 && data.reporterLevel <= 6));
    }

    function isValidSosRequest(data) {
      return data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100 &&
             data.ownerDni is string && data.ownerDni.size() > 0 && data.ownerDni.size() <= 20 &&
             data.vehicleModel is string && data.vehicleModel.size() > 0 && data.vehicleModel.size() <= 100 &&
             data.licensePlate is string && data.licensePlate.size() > 0 && data.licensePlate.size() <= 20 &&
             data.assistanceType is string && data.assistanceType.size() > 0 && data.assistanceType.size() <= 100 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.status in ['active', 'resolved'] &&
             (!('dniVerified' in data) || data.dniVerified is bool) &&
             (!('vehicleColor' in data) || data.vehicleColor == null || (data.vehicleColor is string && data.vehicleColor.size() <= 50)) &&
             (!('routeDescription' in data) || data.routeDescription == null || (data.routeDescription is string && data.routeDescription.size() <= 300)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30));
    }

    function isValidHitchhikeRequest(data) {
      return data.userUid is string && data.userUid.size() <= 128 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.userDni is string && data.userDni.size() > 0 && data.userDni.size() <= 20 &&
             data.roleCategory is string && data.roleCategory.size() > 0 && data.roleCategory.size() <= 100 &&
             data.pickupPoint is string && data.pickupPoint.size() > 0 && data.pickupPoint.size() <= 150 &&
             data.destination is string && data.destination.size() > 0 && data.destination.size() <= 150 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.status in ['waiting', 'picked_up'] &&
             (!('pairedPlate' in data) || data.pairedPlate == null || (data.pairedPlate is string && data.pairedPlate.size() <= 20));
    }

    function isValidPresence(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('userName' in data) || data.userName == null || (data.userName is string && data.userName.size() <= 100)) &&
             (!('routeName' in data) || data.routeName == null || (data.routeName is string && data.routeName.size() <= 120)) &&
             (!('speedKmH' in data) || data.speedKmH is number) &&
             (!('isDriving' in data) || data.isDriving is bool) &&
             (!('latitude' in data) || data.latitude is number) &&
             (!('longitude' in data) || data.longitude is number) &&
             (!('timestampMillis' in data) || data.timestampMillis is int || data.timestampMillis is number);
    }

    function isValidBaulVialItem(data) {
      return data.type in ['encontrado', 'perdido'] &&
             data.category in ['patente', 'documento', 'billetera', 'celular', 'llaves', 'equipaje', 'mascota', 'otro'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.roadName is string && data.roadName.size() > 0 && data.roadName.size() <= 120 &&
             data.publisherUid is string && data.publisherUid.size() > 0 && data.publisherUid.size() <= 128 &&
             data.verificationQuestion is string && data.verificationQuestion.size() > 0 && data.verificationQuestion.size() <= 200 &&
             data.claimStatus in ['sin_reclamo', 'pendiente', 'aprobado', 'rechazado'] &&
             data.status in ['activo', 'devuelto'] &&
             (!('publicDescription' in data) || data.publicDescription == null || (data.publicDescription is string && data.publicDescription.size() <= 500)) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0)) &&
             (!('publisherName' in data) || data.publisherName == null || (data.publisherName is string && data.publisherName.size() <= 100)) &&
             (!('safeDropoffPlace' in data) || data.safeDropoffPlace == null || (data.safeDropoffPlace is string && data.safeDropoffPlace.size() <= 150)) &&
             (!('claimantUid' in data) || data.claimantUid == null || (data.claimantUid is string && data.claimantUid.size() <= 128)) &&
             (!('claimantName' in data) || data.claimantName == null || (data.claimantName is string && data.claimantName.size() <= 100)) &&
             (!('claimantAnswer' in data) || data.claimantAnswer == null || (data.claimantAnswer is string && data.claimantAnswer.size() <= 250)) &&
             (!('claimantContact' in data) || data.claimantContact == null || (data.claimantContact is string && data.claimantContact.size() <= 40)) &&
             (!('publisherContact' in data) || data.publisherContact == null || (data.publisherContact is string && data.publisherContact.size() <= 40));
    }

    function isValidSeguimeId(id) {
      return id is string && id.size() >= 16 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSeguimeSession(data) {
      return data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
             data.driverName is string && data.driverName.size() > 0 && data.driverName.size() <= 100 &&
             (!('vehicleSummary' in data) || data.vehicleSummary == null || (data.vehicleSummary is string && data.vehicleSummary.size() <= 120)) &&
             (!('destinationTitle' in data) || data.destinationTitle == null || (data.destinationTitle is string && data.destinationTitle.size() <= 150)) &&
             (!('originName' in data) || data.originName == null || (data.originName is string && data.originName.size() <= 150)) &&
             data.status in ['active', 'arrived', 'cancelled'] &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             (!('speedKmH' in data) || (data.speedKmH is number && data.speedKmH >= 0.0 && data.speedKmH <= 350.0)) &&
             (!('heading' in data) || (data.heading is number && data.heading >= -1.0 && data.heading <= 360.0)) &&
             (!('offlineBuffered' in data) || data.offlineBuffered is bool) &&
             (!('recentPoints' in data) || (data.recentPoints is list && data.recentPoints.size() <= 40)) &&
             (data.expiresAtMillis is int || data.expiresAtMillis is number);
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'name', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       (!('isBetaTester' in incoming()) || incoming().isBetaTester == false || isAdmin()) &&
                       isValidUser(incoming());
      allow update: if isSignedIn() &&
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('isBetaTester' in incoming()) || incoming().isBetaTester == existing().get('isBetaTester', false) || isAdmin()) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidUser(incoming());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- Public Referral Code Directory (Single-doc get only; prevents user scraping) ---
    match /referral_codes/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(code) &&
                       incoming().code == code &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['code', 'ownerUid', 'createdAt']) &&
                       incoming().keys().hasOnly(['code', 'ownerUid', 'ownerName', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidReferralCode(incoming());
      allow update, delete: if isAdmin();
    }

    // --- Referral Attributions (1 per invited driver ID) ---
    match /referrals/{refereeUid} {
      allow get: if isSignedIn() && isValidId(refereeUid) && (refereeUid == request.auth.uid || existing().referrerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.refereeUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(refereeUid) &&
                       refereeUid == request.auth.uid &&
                       incoming().refereeUid == request.auth.uid &&
                       incoming().referrerUid != request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().keys().hasAll(['refereeUid', 'referrerUid', 'code', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['refereeUid', 'refereeName', 'referrerUid', 'code', 'status', 'rewardGrantedToReferee', 'rewardGrantedToReferrer', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidReferralRecord(incoming()) &&
                       exists(/databases/$(database)/documents/referral_codes/$(incoming().code)) &&
                       get(/databases/$(database)/documents/referral_codes/$(incoming().code)).data.ownerUid == incoming().referrerUid;
      allow update: if isSignedIn() &&
                       isValidId(refereeUid) &&
                       incoming().refereeUid == existing().refereeUid &&
                       incoming().referrerUid == existing().referrerUid &&
                       incoming().code == existing().code &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidReferralRecord(incoming()) &&
                       (
                         isAdmin() ||
                         (
                           existing().referrerUid == request.auth.uid &&
                           existing().rewardGrantedToReferrer == false &&
                           incoming().rewardGrantedToReferrer == true &&
                           incoming().status == 'claimed' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['rewardGrantedToReferrer', 'status', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin();
    }

    // --- App Global Configs (billing & feature rollout flags) ---
    match /app_config/{configId} {
      // 'features' holds zero PII (hidden|beta|public module modes) so Guest Mode can also hide gated tabs
      allow get: if configId == 'features' || (isSignedIn() && configId == 'billing');
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                       (
                         (configId == 'billing' &&
                          incoming().keys().hasAll(['mercadoPagoAlias', 'proPriceArs']) &&
                          isValidBillingConfig(incoming())) ||
                         (configId == 'features' &&
                          incoming().keys().hasAll(['aventonMode', 'baulVialMode']) &&
                          incoming().keys().hasOnly(['aventonMode', 'baulVialMode', 'reclamosMode', 'proConversionMode', 'referralsMode', 'preTripChecklistMode', 'updatedAt']) &&
                          isValidFeatureFlags(incoming()))
                       ) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));
      allow update: if isAdmin() &&
                       (
                         (configId == 'billing' && isValidBillingConfig(incoming())) ||
                         (configId == 'features' &&
                          incoming().keys().hasOnly(['aventonMode', 'baulVialMode', 'reclamosMode', 'proConversionMode', 'referralsMode', 'preTripChecklistMode', 'updatedAt']) &&
                          isValidFeatureFlags(incoming()))
                       ) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));
      allow delete: if isAdmin();
    }

    // --- Community Road Hazard & Pothole Alerts ---
    // Active public road hazards can be read in Guest Mode (read-only); writes require Google Sign-In.
    match /alerts/{alertId} {
      allow get: if isValidId(alertId) && (isSignedIn() || (resource != null && resource.data.status == 'active'));
      allow list: if resource.data.status == 'active' || (isSignedIn() && (resource.data.status in ['active', 'resolved'] || resource.data.reporterUid == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() &&
                       isValidId(alertId) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().keys().hasAll(['type', 'latitude', 'longitude', 'reporterUid', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidRoadAlert(incoming());
      allow update: if isSignedIn() &&
                       isValidId(alertId) &&
                       isValidRoadAlert(incoming()) &&
                       (!('authorBonusAwarded' in incoming()) ||
                         incoming().authorBonusAwarded == existing().get('authorBonusAwarded', false) ||
                         existing().reporterUid == request.auth.uid ||
                         isAdmin()) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));
      allow delete: if isSignedIn() && (isValidId(alertId) || isAdmin());
    }

    // --- SOS Mechanical Assistance Requests ---
    match /sos_requests/{sosId} {
      allow get: if isSignedIn() && (isValidId(sosId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.status in ['active', 'resolved'] || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(sosId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['ownerUid', 'ownerName', 'ownerDni', 'vehicleModel', 'licensePlate', 'assistanceType', 'latitude', 'longitude', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidSosRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(sosId) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidSosRequest(incoming());
      allow delete: if isSignedIn() && (isValidId(sosId) || isAdmin());
    }

    // --- Safe Hitchhike / Aventón Seguro Requests ---
    match /hitchhike_requests/{hitchhikeId} {
      allow get: if isSignedIn() && (isValidId(hitchhikeId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.status in ['waiting', 'picked_up'] || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(hitchhikeId) &&
                       incoming().userUid == request.auth.uid &&
                       incoming().keys().hasAll(['userUid', 'userName', 'userDni', 'roleCategory', 'pickupPoint', 'destination', 'latitude', 'longitude', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidHitchhikeRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(hitchhikeId) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidHitchhikeRequest(incoming());
      allow delete: if isSignedIn() && (isValidId(hitchhikeId) || isAdmin());
    }

    // --- Real-time Online Presence & Active Drivers ---
    match /online_presence/{presenceId} {
      allow get: if isSignedIn() && (isValidId(presenceId) || isAdmin());
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                            isValidId(presenceId) &&
                            presenceId == request.auth.uid &&
                            incoming().userId == request.auth.uid &&
                            isValidPresence(incoming()) &&
                            (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));
      allow delete: if isSignedIn() && (presenceId == request.auth.uid || isAdmin());
    }

    // --- Baúl Vial: Roadside Lost & Found with Ownership Proof ---
    match /baul_vial/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId);
      allow list: if isSignedIn() && (resource.data.status in ['activo', 'devuelto'] || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().publisherUid == request.auth.uid &&
                       incoming().keys().hasAll(['type', 'category', 'title', 'roadName', 'publisherUid', 'verificationQuestion', 'claimStatus', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidBaulVialItem(incoming());
      allow update: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().publisherUid == existing().publisherUid &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidBaulVialItem(incoming()) &&
                       (
                         existing().publisherUid == request.auth.uid ||
                         isAdmin() ||
                         (
                           incoming().claimantUid == request.auth.uid &&
                           incoming().claimStatus == 'pendiente' &&
                           existing().status == 'activo' &&
                           (existing().claimStatus in ['sin_reclamo', 'rechazado'] || existing().claimantUid == request.auth.uid)
                         )
                       );
      allow delete: if isSignedIn() && isValidId(itemId) && (existing().publisherUid == request.auth.uid || isAdmin());
    }

    // --- Seguime (Tiempo Real): Private Family Tracking Links (get by unguessable token; list blocked) ---
    match /seguime_sessions/{sessionId} {
      allow get: if isValidSeguimeId(sessionId);
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidSeguimeId(sessionId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['ownerUid', 'driverName', 'status', 'latitude', 'longitude', 'expiresAtMillis', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidSeguimeSession(incoming());
      allow update: if isSignedIn() &&
                       isValidSeguimeId(sessionId) &&
                       (existing().ownerUid == request.auth.uid || isAdmin()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidSeguimeSession(incoming());
      allow delete: if isSignedIn() && isValidSeguimeId(sessionId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
}
