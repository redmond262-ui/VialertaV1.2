rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email == 'redmond262@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('dni' in data) || data.dni == null || (data.dni is string && data.dni.size() <= 20)) &&
             (!('isDniVerified' in data) || data.isDniVerified is bool) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
             (!('defaultVehicle' in data) || data.defaultVehicle == null || (data.defaultVehicle is string && data.defaultVehicle.size() <= 100)) &&
             (!('defaultPlate' in data) || data.defaultPlate == null || (data.defaultPlate is string && data.defaultPlate.size() <= 20)) &&
             (!('trustRole' in data) || data.trustRole in ['docente', 'estudiante', 'salud', 'policia', 'trabajador', 'general', 'admin']) &&
             (!('isProUser' in data) || data.isProUser is bool) &&
             (!('proExpiresAtMillis' in data) || data.proExpiresAtMillis is int || data.proExpiresAtMillis is number) &&
             (!('pointsRuta' in data) || data.pointsRuta is int) &&
             (!('dailyPointsEarned' in data) || data.dailyPointsEarned is int) &&
             (!('lastPointsDateString' in data) || data.lastPointsDateString == null || data.lastPointsDateString is string);
    }

    function isValidRoadAlert(data) {
      return data.type is string && data.type.size() > 0 && data.type.size() <= 100 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.reporterUid is string && data.reporterUid.size() <= 128 &&
             data.status in ['active', 'resolved'] &&
             (!('heading' in data) || data.heading is number) &&
             (!('directionDesc' in data) || data.directionDesc == null || (data.directionDesc is string && data.directionDesc.size() <= 100)) &&
             (!('depthCm' in data) || data.depthCm is int && data.depthCm >= 0 && data.depthCm <= 100) &&
             (!('roadName' in data) || data.roadName == null || (data.roadName is string && data.roadName.size() <= 120)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             (!('reporterName' in data) || data.reporterName == null || (data.reporterName is string && data.reporterName.size() <= 100)) &&
             (!('affectsBothDirections' in data) || data.affectsBothDirections is bool) &&
             (!('estimatedKm' in data) || data.estimatedKm is int) &&
             (!('confirmations' in data) || data.confirmations is int && data.confirmations >= 0) &&
             (!('notThereVotes' in data) || data.notThereVotes is int && data.notThereVotes >= 0) &&
             (!('roadCategory' in data) || data.roadCategory == null || (data.roadCategory is string && data.roadCategory.size() <= 50)) &&
             (!('connectsTowns' in data) || data.connectsTowns == null || (data.connectsTowns is string && data.connectsTowns.size() <= 150));
    }

    function isValidSosRequest(data) {
      return data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100 &&
             data.ownerDni is string && data.ownerDni.size() > 0 && data.ownerDni.size() <= 20 &&
             data.vehicleModel is string && data.vehicleModel.size() > 0 && data.vehicleModel.size() <= 100 &&
             data.licensePlate is string && data.licensePlate.size() > 0 && data.licensePlate.size() <= 20 &&
             data.assistanceType is string && data.assistanceType.size() > 0 && data.assistanceType.size() <= 100 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.status in ['active', 'resolved'] &&
             (!('dniVerified' in data) || data.dniVerified is bool) &&
             (!('vehicleColor' in data) || data.vehicleColor == null || (data.vehicleColor is string && data.vehicleColor.size() <= 50)) &&
             (!('routeDescription' in data) || data.routeDescription == null || (data.routeDescription is string && data.routeDescription.size() <= 300)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30));
    }

    function isValidHitchhikeRequest(data) {
      return data.userUid is string && data.userUid.size() <= 128 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.userDni is string && data.userDni.size() > 0 && data.userDni.size() <= 20 &&
             data.roleCategory is string && data.roleCategory.size() > 0 && data.roleCategory.size() <= 100 &&
             data.pickupPoint is string && data.pickupPoint.size() > 0 && data.pickupPoint.size() <= 150 &&
             data.destination is string && data.destination.size() > 0 && data.destination.size() <= 150 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.status in ['waiting', 'picked_up'] &&
             (!('pairedPlate' in data) || data.pairedPlate == null || (data.pairedPlate is string && data.pairedPlate.size() <= 20));
    }

    function isValidPresence(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('userName' in data) || data.userName == null || (data.userName is string && data.userName.size() <= 100)) &&
             (!('routeName' in data) || data.routeName == null || (data.routeName is string && data.routeName.size() <= 120)) &&
             (!('speedKmH' in data) || data.speedKmH is number) &&
             (!('isDriving' in data) || data.isDriving is bool) &&
             (!('latitude' in data) || data.latitude is number) &&
             (!('longitude' in data) || data.longitude is number) &&
             (!('timestampMillis' in data) || data.timestampMillis is int || data.timestampMillis is number);
    }

    function isValidBaulVialItem(data) {
      return data.type in ['encontrado', 'perdido'] &&
             data.category in ['patente', 'documento', 'billetera', 'celular', 'llaves', 'equipaje', 'mascota', 'otro'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.roadName is string && data.roadName.size() > 0 && data.roadName.size() <= 120 &&
             data.publisherUid is string && data.publisherUid.size() > 0 && data.publisherUid.size() <= 128 &&
             data.verificationQuestion is string && data.verificationQuestion.size() > 0 && data.verificationQuestion.size() <= 200 &&
             data.claimStatus in ['sin_reclamo', 'pendiente', 'aprobado', 'rechazado'] &&
             data.status in ['activo', 'devuelto'] &&
             (!('publicDescription' in data) || data.publicDescription == null || (data.publicDescription is string && data.publicDescription.size() <= 500)) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0)) &&
             (!('publisherName' in data) || data.publisherName == null || (data.publisherName is string && data.publisherName.size() <= 100)) &&
             (!('safeDropoffPlace' in data) || data.safeDropoffPlace == null || (data.safeDropoffPlace is string && data.safeDropoffPlace.size() <= 150)) &&
             (!('claimantUid' in data) || data.claimantUid == null || (data.claimantUid is string && data.claimantUid.size() <= 128)) &&
             (!('claimantName' in data) || data.claimantName == null || (data.claimantName is string && data.claimantName.size() <= 100)) &&
             (!('claimantAnswer' in data) || data.claimantAnswer == null || (data.claimantAnswer is string && data.claimantAnswer.size() <= 250)) &&
             (!('claimantContact' in data) || data.claimantContact == null || (data.claimantContact is string && data.claimantContact.size() <= 40)) &&
             (!('publisherContact' in data) || data.publisherContact == null || (data.publisherContact is string && data.publisherContact.size() <= 40));
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'name', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUser(incoming());
      allow update: if isSignedIn() &&
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidUser(incoming());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- Community Road Hazard & Pothole Alerts ---
    match /alerts/{alertId} {
      allow get: if isSignedIn() && (isValidId(alertId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.status in ['active', 'resolved'] || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(alertId) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().keys().hasAll(['type', 'latitude', 'longitude', 'reporterUid', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidRoadAlert(incoming());
      allow update: if isSignedIn() &&
                       isValidId(alertId) &&
                       isValidRoadAlert(incoming()) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));
      allow delete: if isSignedIn() && (isValidId(alertId) || isAdmin());
    }

    // --- SOS Mechanical Assistance Requests ---
    match /sos_requests/{sosId} {
      allow get: if isSignedIn() && (isValidId(sosId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.status in ['active', 'resolved'] || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(sosId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['ownerUid', 'ownerName', 'ownerDni', 'vehicleModel', 'licensePlate', 'assistanceType', 'latitude', 'longitude', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidSosRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(sosId) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidSosRequest(incoming());
      allow delete: if isSignedIn() && (isValidId(sosId) || isAdmin());
    }

    // --- Safe Hitchhike / Aventón Seguro Requests ---
    match /hitchhike_requests/{hitchhikeId} {
      allow get: if isSignedIn() && (isValidId(hitchhikeId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.status in ['waiting', 'picked_up'] || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(hitchhikeId) &&
                       incoming().userUid == request.auth.uid &&
                       incoming().keys().hasAll(['userUid', 'userName', 'userDni', 'roleCategory', 'pickupPoint', 'destination', 'latitude', 'longitude', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidHitchhikeRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(hitchhikeId) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidHitchhikeRequest(incoming());
      allow delete: if isSignedIn() && (isValidId(hitchhikeId) || isAdmin());
    }

    // --- Real-time Online Presence & Active Drivers ---
    match /online_presence/{presenceId} {
      allow get: if isSignedIn() && (isValidId(presenceId) || isAdmin());
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                            isValidId(presenceId) &&
                            presenceId == request.auth.uid &&
                            incoming().userId == request.auth.uid &&
                            isValidPresence(incoming()) &&
                            (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));
      allow delete: if isSignedIn() && (presenceId == request.auth.uid || isAdmin());
    }

    // --- Baúl Vial: Roadside Lost & Found with Ownership Proof ---
    match /baul_vial/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId);
      allow list: if isSignedIn() && (resource.data.status in ['activo', 'devuelto'] || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().publisherUid == request.auth.uid &&
                       incoming().keys().hasAll(['type', 'category', 'title', 'roadName', 'publisherUid', 'verificationQuestion', 'claimStatus', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidBaulVialItem(incoming());
      allow update: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().publisherUid == existing().publisherUid &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidBaulVialItem(incoming()) &&
                       (
                         existing().publisherUid == request.auth.uid ||
                         isAdmin() ||
                         (
                           incoming().claimantUid == request.auth.uid &&
                           incoming().claimStatus == 'pendiente' &&
                           existing().status == 'activo' &&
                           (existing().claimStatus in ['sin_reclamo', 'rechazado'] || existing().claimantUid == request.auth.uid)
                         )
                       );
      allow delete: if isSignedIn() && isValidId(itemId) && (existing().publisherUid == request.auth.uid || isAdmin());
    }
  }
}
